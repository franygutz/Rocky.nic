# Copiar como .env y completar (Windows: Copy-Item .env.example .env · Linux/macOS: cp .env.example .env).
# Nunca subir .env a Git: la clave de NASA es personal.

# Clave gratuita de https://api.nasa.gov/ (DEMO_KEY funciona, pero con muy pocas consultas por hora).
NASA_API_KEY=DEMO_KEY

# Período a importar desde DONKI (YYYY-MM-DD, máximo 30 días). Ejemplo: tormenta de mayo de 2024.
NASA_START_DATE=2024-05-08
NASA_END_DATE=2024-05-14

# Opcionales del servidor local
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/moon-v03.sqlite
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500,http://localhost:4173,http://127.0.0.1:4173
